generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Author {
  id              String          @id @default(uuid())
  slug            String          @unique
  name            String
  email           String          @unique
  passwordHash    String?         @map("password_hash")
  bio             String?
  role            String          @default("user")
  credits         Int             @default(3)
  plan            String          @default("free")
  planExpireAt    DateTime?       @map("plan_expire_at")
  defaultThemeId  String?         @map("default_theme_id")
  themes          Theme[]
  works           Work[]
  socialAccounts  SocialAccount[]
  createdAt       DateTime        @default(now()) @map("created_at")

  @@map("authors")
}

model Theme {
  id             String   @id @default(uuid())
  author         Author?  @relation(fields: [authorId], references: [id])
  authorId       String?  @map("author_id")
  name           String   @default("기본 테마")
  preset         String   @default("midnight")
  overrides      Json?
  rawDescription String?  @map("raw_description")
  bakedCssUrl    String?  @map("baked_css_url")
  isSlotted      Boolean  @default(true) @map("is_slotted")
  source         String   @default("user")
  updatedAt      DateTime @updatedAt @map("updated_at")
  works          Work[]

  @@index([authorId])
  @@map("themes")
}

model Work {
  id          String    @id @default(uuid())
  author      Author    @relation(fields: [authorId], references: [id])
  authorId    String    @map("author_id")
  slug        String
  title       String
  subtitle    String?
  description String?
  coverImage  String?   @map("cover_image")
  context     String?   // 작품 맥락 (세계관, 캐릭터, 배경 — 채팅 시 고정 주입)
  instructions String?  // 작품 지침 (문체 규칙, 톤, 금지사항 — 채팅 시 고정 주입)
  themeId     String?   @map("theme_id")
  theme       Theme?    @relation(fields: [themeId], references: [id])
  viewCount   Int       @default(0) @map("view_count")
  episodes    Episode[]
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([authorId, slug])
  @@index([authorId])
  @@map("works")
}

model Episode {
  id             String    @id @default(uuid())
  work           Work      @relation(fields: [workId], references: [id])
  workId         String    @map("work_id")
  slug           String
  title          String
  subtitle       String?
  description    String?
  type           String    @default("episode")
  orderNum       Int       @map("order_num")
  blocks         Json
  rawMd          String    @map("raw_md")
  viewCount      Int       @default(0) @map("view_count")
  sourceFormat   String    @default("markdown") @map("source_format")
  status         String    @default("upload") @map("status")
  isIndexed      Boolean   @default(false) @map("is_indexed")
  sharedToken    String?   @unique @map("shared_token")
  sharedExpireAt DateTime? @map("shared_expire_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@unique([workId, slug])
  @@index([workId, orderNum])
  @@map("episodes")
}

model CreditLog {
  id        String   @id @default(uuid())
  authorId  String   @map("author_id")
  amount    Int
  reason    String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("credit_logs")
}

model SocialAccount {
  id            String   @id @default(uuid())
  author        Author   @relation(fields: [authorId], references: [id])
  authorId      String   @map("author_id")
  provider      String
  providerId    String   @map("provider_id")
  providerEmail String?  @map("provider_email")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([provider, providerId])
  @@map("social_accounts")
}

model SignupHistory {
  providerId    String   @id @map("provider_id")
  firstSignupAt DateTime @default(now()) @map("first_signup_at")
  signupCount   Int      @default(1) @map("signup_count")

  @@map("signup_history")
}

model Bookmark {
  id        String   @id @default(uuid())
  authorId  String   @map("author_id")
  episodeId String   @map("episode_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([authorId, episodeId])
  @@index([authorId])
  @@map("bookmarks")
}

model ReadingProgress {
  id         String   @id @default(uuid())
  authorId   String   @map("author_id")
  episodeId  String   @map("episode_id")
  blockIndex Int      @map("block_index")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([authorId, episodeId])
  @@map("reading_progress")
}

model Like {
  id        String   @id @default(uuid())
  authorId  String?  @map("author_id")
  episodeId String   @map("episode_id")
  ipAddress String?  @map("ip_address")
  cookieId  String?  @map("cookie_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([authorId, episodeId])
  @@index([episodeId])
  @@index([ipAddress, cookieId, episodeId])
  @@map("likes")
}

model Subscription {
  id             String   @id @default(uuid())
  subscriberId   String   @map("subscriber_id")
  targetAuthorId String   @map("target_author_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([subscriberId, targetAuthorId])
  @@map("subscriptions")
}

model Comment {
  id           String    @id @default(uuid())
  authorId     String?   @map("author_id")
  episodeId    String    @map("episode_id")
  content      String
  nickname     String?
  passwordHash String?   @map("password_hash")
  ipAddress    String?   @map("ip_address")
  parentId     String?   @map("parent_id")
  parent       Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies      Comment[] @relation("CommentReplies")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([episodeId, createdAt])
  @@index([parentId])
  @@map("comments")
}

model Payment {
  id            String    @id @default(uuid())
  authorId      String    @map("author_id")
  productId     String    @map("product_id")
  amount        Int
  credits       Int
  externalTransactionId String?   @unique @map("external_transaction_id")
  status        String    @default("pending")
  createdAt     DateTime  @default(now()) @map("created_at")
  completedAt   DateTime? @map("completed_at")

  @@map("payments")
}

model DailyView {
  id     String   @id @default(uuid())
  workId String   @map("work_id")
  date   DateTime @db.Date
  count  Int      @default(0)

  @@unique([workId, date])
  @@map("daily_views")
}

model ChatSession {
  id        String        @id @default(uuid())
  authorId  String        @map("author_id")
  workId    String        @map("work_id")
  title     String        @default("새 대화")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  messages  ChatMessage[]

  @@index([authorId, workId])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String      @map("session_id")
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String      // "user" | "assistant"
  content   String
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}
