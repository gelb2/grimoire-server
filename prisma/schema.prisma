generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// PAY-P3-E §3-1 매트릭스 정합 — Author 모델 역참조 영역 (Prisma 양방향 @relation 강제 영역 정합)
/// - 회계/감사 영구 보존 영역 (Restrict 8건) = Author hard delete 시 PG 자동 차단 정합 (USER-SOFT-DELETE sprint 영역 진입 전 본 sprint 영역에서 차단 강제 박제)
/// - Cascade 영역 (refresh_tokens / chat_sessions / bookmarks / reading_progress / subscriptions) = 사용자 종속 즉시 무효
/// - SetNull 영역 (likes / comments / access_logs / reports / featured_works.adminId / user_sanctions.adminId) = 익명화 + 운영자 변경 보존
model Author {
  id             String          @id @default(uuid())
  slug           String          @unique
  name           String
  email          String          @unique
  passwordHash   String?         @map("password_hash")
  bio            String?
  role           String          @default("user")
  credits        Int             @default(0)
  plan           String          @default("free")
  planExpireAt   DateTime?       @map("plan_expire_at") @db.Timestamptz(3)
  defaultThemeId String?         @map("default_theme_id")
  themes         Theme[]
  works          Work[]
  socialAccounts SocialAccount[]

  // Cascade 영역 (사용자 종속, Author 삭제 시 즉시 무효)
  bookmarks       Bookmark[]
  readingProgress ReadingProgress[]
  subscribedTo    Subscription[]    @relation("Subscriber")
  subscribers     Subscription[]    @relation("TargetAuthor")
  chatSessions    ChatSession[]
  refreshTokens   RefreshToken[]

  // Restrict 영역 (회계/세무/감사 영구 보존, Author hard delete 시 PG 자동 차단)
  payments         Payment[]
  creditLogs       CreditLog[]
  analysisReports  AnalysisReport[]
  sanctionedAuthor UserSanction[]   @relation("SanctionedAuthor")

  // SetNull 영역 (익명화 + 운영자 변경 시 기록 보존)
  likes              Like[]
  comments           Comment[]
  accessLogs         AccessLog[]
  reportsReporter    Report[]        @relation("Reporter")
  reportsResolver    Report[]        @relation("Resolver")
  featuredWorksAdmin FeaturedWork[]  @relation("FeaturedWorkAdmin")
  sanctioningAdmin   UserSanction[]  @relation("SanctioningAdmin")
  adminAuditLogs     AdminAuditLog[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  // USER-SOFT-DELETE sprint (2026-05-15) — Author soft delete 표식 영역
  // NULL = 활성 / NOT NULL = soft deleted (deletedAt 시점 박제, 30일 후 cron hard delete 영역)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([deletedAt])
  @@map("authors")
}

model Theme {
  id             String   @id @default(uuid())
  author         Author?  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId       String?  @map("author_id")
  name           String   @default("내 테마")
  preset         String   @default("midnight")
  overrides      Json?
  rawDescription String?  @map("raw_description")
  bakedCssUrl    String?  @map("baked_css_url")
  isSlotted      Boolean  @default(false) @map("is_slotted")
  source         String   @default("user")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  works          Work[]

  @@index([authorId])
  @@map("themes")
}

model Work {
  id            String         @id @default(uuid())
  author        Author         @relation(fields: [authorId], references: [id], onDelete: Restrict)
  authorId      String         @map("author_id")
  slug          String
  title         String
  subtitle      String?
  description   String?
  coverImage    String?        @map("cover_image")
  context       String? // 작품 맥락 (세계관, 캐릭터, 배경 — 채팅 시 고정 주입)
  instructions  String? // 작품 지침 (문체 규칙, 톤, 금지사항 — 채팅 시 고정 주입)
  themeId       String?        @map("theme_id")
  theme         Theme?         @relation(fields: [themeId], references: [id], onDelete: SetNull)
  viewCount     Int            @default(0) @map("view_count")
  episodes      Episode[]
  dailyViews    DailyView[]
  featuredWorks FeaturedWork[]
  chatSessions  ChatSession[]
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([authorId, slug])
  @@index([authorId])
  @@map("works")
}

model Episode {
  id              String            @id @default(uuid())
  work            Work              @relation(fields: [workId], references: [id], onDelete: Cascade)
  workId          String            @map("work_id")
  slug            String
  title           String
  subtitle        String?
  description     String?
  type            String            @default("episode")
  orderNum        Int               @map("order_num")
  blocks          Json
  rawMd           String            @map("raw_md")
  viewCount       Int               @default(0) @map("view_count")
  sourceFormat    String            @default("markdown") @map("source_format")
  status          String            @default("upload") @map("status")
  isIndexed       Boolean           @default(false) @map("is_indexed")
  sharedToken     String?           @unique @map("shared_token")
  sharedExpireAt  DateTime?         @map("shared_expire_at") @db.Timestamptz(3)
  bookmarks       Bookmark[]
  readingProgress ReadingProgress[]
  likes           Like[]
  comments        Comment[]
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([workId, slug])
  @@index([workId, orderNum])
  @@map("episodes")
}

model CreditLog {
  id        String   @id @default(uuid())
  authorId  String   @map("author_id")
  author    Author   @relation(fields: [authorId], references: [id], onDelete: Restrict)
  amount    Int
  reason    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("credit_logs")
}

model SocialAccount {
  id            String   @id @default(uuid())
  author        Author   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId      String   @map("author_id")
  provider      String
  providerId    String   @map("provider_id")
  providerEmail String?  @map("provider_email")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([provider, providerId])
  @@map("social_accounts")
}

model SignupHistory {
  providerId    String   @id @map("provider_id")
  firstSignupAt DateTime @default(now()) @map("first_signup_at") @db.Timestamptz(3)
  signupCount   Int      @default(1) @map("signup_count")

  @@map("signup_history")
}

model Bookmark {
  id        String   @id @default(uuid())
  authorId  String   @map("author_id")
  author    Author   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  episodeId String   @map("episode_id")
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([authorId, episodeId])
  @@index([authorId])
  @@map("bookmarks")
}

model ReadingProgress {
  id         String   @id @default(uuid())
  authorId   String   @map("author_id")
  author     Author   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  episodeId  String   @map("episode_id")
  episode    Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  blockIndex Int      @map("block_index")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([authorId, episodeId])
  @@map("reading_progress")
}

model Like {
  id        String   @id @default(uuid())
  authorId  String?  @map("author_id")
  author    Author?  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  episodeId String   @map("episode_id")
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  ipAddress String?  @map("ip_address")
  cookieId  String?  @map("cookie_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([authorId, episodeId])
  @@index([episodeId])
  @@index([ipAddress, cookieId, episodeId])
  @@map("likes")
}

model Subscription {
  id             String   @id @default(uuid())
  subscriberId   String   @map("subscriber_id")
  subscriber     Author   @relation("Subscriber", fields: [subscriberId], references: [id], onDelete: Cascade)
  targetAuthorId String   @map("target_author_id")
  targetAuthor   Author   @relation("TargetAuthor", fields: [targetAuthorId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([subscriberId, targetAuthorId])
  @@map("subscriptions")
}

model Comment {
  id           String    @id @default(uuid())
  authorId     String?   @map("author_id")
  author       Author?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  episodeId    String    @map("episode_id")
  episode      Episode   @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  content      String
  nickname     String?
  passwordHash String?   @map("password_hash")
  ipAddress    String?   @map("ip_address")
  parentId     String?   @map("parent_id")
  parent       Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies      Comment[] @relation("CommentReplies")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([episodeId, createdAt])
  @@index([parentId])
  @@map("comments")
}

model Payment {
  id                    String      @id @default(uuid())
  authorId              String      @map("author_id")
  author                Author      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  productId             String      @map("product_id")
  amount                Int
  credits               Int
  externalTransactionId String?     @unique @map("external_transaction_id")
  status                String      @default("pending")
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt           DateTime?   @map("completed_at") @db.Timestamptz(3)
  refundLogs            RefundLog[]

  @@map("payments")
}

/// 웹훅 이벤트 멱등성 박제 (Sprint PAY-P0-1, 2026-05-03)
/// - eventId @unique: PG webhook 재전송 시 race condition 차단 (P2002 → safe skip)
/// - source: PG 식별 ('polar' / 향후 다른 PG)
/// - status: 'processed' | 'skipped' | 'failed'
/// - payload: 정규화된 NormalizedWebhookEvent 박제 (디버깅용)
/// 정본: `.claude/shared-contracts.md` §11 WebhookEventIdempotency
model WebhookEvent {
  id            String    @id @default(uuid())
  eventId       String    @unique @map("event_id")
  source        String    @default("polar")
  eventType     String    @map("event_type")
  payload       Json
  status        String    @default("processed")
  errorMessage  String?   @map("error_message")
  processedAt   DateTime  @default(now()) @map("processed_at") @db.Timestamptz(3)
  // PAY-P2-5 audit retention (영구 보존 + 90일 후 PII 마스킹)
  maskedAt      DateTime? @map("masked_at") @db.Timestamptz(3)
  retentionTier String    @default("active") @map("retention_tier")

  @@index([eventType, processedAt])
  @@index([retentionTier, processedAt])
  @@map("webhook_events")
}

model DailyView {
  id     String   @id @default(uuid())
  workId String   @map("work_id")
  work   Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date
  count  Int      @default(0)

  @@unique([workId, date])
  @@map("daily_views")
}

model ChatSession {
  id        String        @id @default(uuid())
  authorId  String        @map("author_id")
  author    Author        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  workId    String        @map("work_id")
  work      Work          @relation(fields: [workId], references: [id], onDelete: Cascade)
  title     String        @default("새 대화")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  messages  ChatMessage[]

  @@index([authorId, workId])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String      @map("session_id")
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String // "user" | "assistant"
  content   String
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  content   String
  isPinned  Boolean  @default(false) @map("is_pinned")
  target    String   @default("all") // all, authors, readers
  adminId   String   @map("admin_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("announcements")
}

model FeaturedWork {
  id        String    @id @default(uuid())
  workId    String    @map("work_id")
  work      Work      @relation(fields: [workId], references: [id], onDelete: Cascade)
  section   String    @default("main") // main, genre, new
  position  Int       @default(0)
  startAt   DateTime? @map("start_at") @db.Timestamptz(3)
  endAt     DateTime? @map("end_at") @db.Timestamptz(3)
  adminId   String?   @map("admin_id")
  admin     Author?   @relation("FeaturedWorkAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([section, position])
  @@map("featured_works")
}

model UserSanction {
  id        String    @id @default(uuid())
  authorId  String    @map("author_id")
  author    Author    @relation("SanctionedAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  type      String // warning, suspend_1d, suspend_7d, suspend_30d, permanent
  reason    String // 욕설, 스팸, 저작권, 기타
  detail    String? // 관리자 메모
  adminId   String?   @map("admin_id")
  admin     Author?   @relation("SanctioningAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  startAt   DateTime  @default(now()) @map("start_at") @db.Timestamptz(3)
  endAt     DateTime? @map("end_at") @db.Timestamptz(3)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([authorId, isActive])
  @@index([endAt])
  @@map("user_sanctions")
}

model Report {
  id         String    @id @default(uuid())
  targetType String    @map("target_type") // work, episode, comment
  targetId   String    @map("target_id")
  reporterId String?   @map("reporter_id")
  reporter   Author?   @relation("Reporter", fields: [reporterId], references: [id], onDelete: SetNull)
  reason     String // obscene, violence, copyright, spam, other
  detail     String?
  status     String    @default("pending") // pending, approved, rejected
  resolvedBy String?   @map("resolved_by")
  resolver   Author?   @relation("Resolver", fields: [resolvedBy], references: [id], onDelete: SetNull)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}

model SystemSetting {
  key       String   @id
  value     String
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_settings")
}

model AccessLog {
  id            String    @id @default(uuid())
  action        String // register, login_success, login_fail, password_change
  authorId      String?   @map("author_id")
  author        Author?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  email         String? // 로그인 실패 시 시도한 이메일 (작가 미식별)
  ip            String?
  userAgent     String?   @map("user_agent")
  detail        String? // 실패 사유 등
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  // PAY-P2-5 audit retention (영구 보존 + 90일 후 PII 마스킹)
  maskedAt      DateTime? @map("masked_at") @db.Timestamptz(3)
  retentionTier String    @default("active") @map("retention_tier")

  @@index([action, createdAt])
  @@index([ip])
  @@index([authorId])
  @@index([retentionTier, createdAt])
  @@map("access_logs")
}

model RefreshToken {
  id        String    @id @default(uuid())
  authorId  String    @map("author_id")
  author    Author    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([authorId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// AI 일관성 분석 리포트 (2026-04-24 F4)
/// 사용자가 분석을 실행할 때마다 결과를 영구 저장 → 대시보드 히스토리에서 재조회.
/// - authorId: 분석 실행자 (소유권)
/// - workId/episodeId: 분석 대상 (작품 + 회차)
/// - workTitle/episodeTitle: 스냅샷 (에피소드 삭제 후에도 히스토리 식별 가능)
/// - types: 실행된 분석 타입 배열 (consistency/tone/character 조합)
/// - results: AnalysisResult[] JSON 전체 — 점수/요약/이슈/제안 원본
/// - creditsCharged: 이번 분석에 실제 차감된 크레딧 (기본 3, 향후 할인 정책 반영 가능)
model AnalysisReport {
  id             String   @id @default(uuid())
  authorId       String   @map("author_id")
  author         Author   @relation(fields: [authorId], references: [id], onDelete: Restrict)
  workId         String   @map("work_id")
  episodeId      String   @map("episode_id")
  workTitle      String   @map("work_title")
  episodeTitle   String   @map("episode_title")
  types          String[] // consistency/tone/character 조합
  results        Json // AnalysisResult[] 전체
  creditsCharged Int      @default(3) @map("credits_charged")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([authorId, createdAt(sort: Desc)])
  @@index([episodeId])
  @@map("analysis_reports")
}

model AdminAuditLog {
  id            String    @id @default(uuid())
  adminId       String    @map("admin_id")
  admin         Author    @relation(fields: [adminId], references: [id], onDelete: Restrict)
  action        String // 예: author_create, credit_grant, episode_delete, plan_change
  targetId      String?   @map("target_id")
  detail        Json? // 변경 전/후 값, 사유 등
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  // PAY-P2-5 audit retention (영구 보존 + 90일 후 PII 마스킹)
  maskedAt      DateTime? @map("masked_at") @db.Timestamptz(3)
  retentionTier String    @default("active") @map("retention_tier")

  @@index([adminId, createdAt])
  @@index([action])
  @@index([retentionTier, createdAt])
  @@map("admin_audit_logs")
}

/// PG↔DB 정합성 검증 cron checkpoint (Sprint PAY-P0-2, 2026-05-03)
/// 단일 row 보장 — id='singleton' 고정. cron 실행마다 동일 row를 upsert.
/// 책 Ch 16 "shared state via DB single-row checkpoint" 패턴.
model ReconciliationCheckpoint {
  id             String   @id @default("singleton")
  lastRunAt      DateTime @map("last_run_at") @db.Timestamptz(3)
  processedCount Int      @default(0) @map("processed_count")
  boostCount     Int      @default(0) @map("boost_count")
  mismatchCount  Int      @default(0) @map("mismatch_count")
  expireCount    Int      @default(0) @map("expire_count")
  errorMessage   String?  @map("error_message")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("reconciliation_checkpoints")
}

/// 환불 정밀 처리 박제 (Sprint PAY-P1-1, 2026-05-03)
/// - paymentId: 환불 대상 Payment FK (1:N — 향후 부분 환불 호환 위해 unique 미부여)
/// - amount: PG 환불 금액 (KRW)
/// - credits: 요청 환수 크레딧 (Author.credits 잔액 충분 시 = 실제 차감, 부족 시 actualDeducted = 잔액)
/// - deficitCredits: 잔액 부족분 (양수 = 외상, 0 = 정상 환수). 운영자 회수 정책 결정 입력.
/// - source: 'webhook' (Polar 자동) / 'manual' (운영자 수동, P2)
/// 정본: `.claude/shared-contracts.md` §13 RefundPaymentAtomically
model RefundLog {
  id             String   @id @default(uuid())
  paymentId      String   @map("payment_id")
  payment        Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  amount         Int // PG 환불 금액 (KRW)
  credits        Int // 실제 환수 크레딧 (actualDeducted)
  deficitCredits Int      @default(0) @map("deficit_credits") // 잔액 부족분 (외상)
  reason         String
  processedAt    DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)
  source         String // 'webhook' | 'manual'

  @@index([paymentId])
  @@map("refund_logs")
}

/// PAY-P2-2: webhook 처리 실패 시 재시도 큐 (Postgres 기반 DLQ — 외부 인프라 의존 0건)
/// - eventId: Polar webhook-id (멱등성 통합 — webhook_events.eventId @unique 정합)
/// - payload: NormalizedWebhookEvent 전체 박제 (재처리 시 동일 페이로드 재호출)
/// - retryCount: 누적 재시도 횟수 (0~10, 10 초과 시 permanent_failed 박제)
/// - lastError: 마지막 실패 메시지 (디버깅용)
/// - nextRetryAt: 다음 재시도 시각 — exp backoff (1m → 5m → 30m → 2h → 12h → 24h)
/// 정본: `.claude/shared-contracts.md` §18 WebhookDLQ
model WebhookRetryQueue {
  id            String    @id @default(uuid())
  eventId       String    @unique @map("event_id") // Polar webhook-id 멱등성
  payload       Json // NormalizedWebhookEvent 전체
  retryCount    Int       @default(0) @map("retry_count")
  lastError     String?   @map("last_error")
  nextRetryAt   DateTime  @map("next_retry_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  // PAY-P2-5 audit retention (영구 보존 + 90일 후 PII 마스킹)
  maskedAt      DateTime? @map("masked_at") @db.Timestamptz(3)
  retentionTier String    @default("active") @map("retention_tier")

  @@index([nextRetryAt])
  @@index([retentionTier, createdAt])
  @@map("webhook_retry_queues")
}
