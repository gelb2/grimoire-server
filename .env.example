# 로컬 개발용 예시. 기존 .env에 덮어쓰지 말고 별도 파일/프로세스로 주입한다.
# 필수: 독립 로컬 DB와 사용자 생성 JWT 비밀값. openssl rand -base64 48로 생성한다.
APP_ENV=localhost
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DATABASE_URL=postgresql://grimoire_local:CHANGE_ME@127.0.0.1:55432/grimoire_local
JWT_SECRET=
CORS_ORIGIN=http://localhost:3001
PUBLIC_API_BASE_URL=http://localhost:3000/api

# 선택: 빈 값이면 해당 외부 기능을 사용할 수 없다. 작성자 키 대체 경로 없음.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# 과거 호환 별칭 OPENAI_KEY도 읽으므로 로컬 격리 실행에서는 비워야 한다.
OPENAI_KEY=
GOOGLE_CLIENT_ID=
RECAPTCHA_SECRET_KEY=

# GCS 업로드: 사용자의 버킷 + ADC. 미설정 시 테마 CSS는 API로 제공, 커버 업로드 거절.
# 로컬에서 활성화하려면 자신의 자격증명 파일을 소스 밖에 두고 경로를 주입한다.
GCS_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=

# 결제: 토큰이 없으면 SDK 호출 차단. 활성화 시 POLAR_SERVER를 반드시 명시한다.
# sandbox는 사용자의 별도 테스트 계정/상품이 필요하다. production은 실제 과금 환경이다.
POLAR_SERVER=sandbox
POLAR_ACCESS_TOKEN=
POLAR_ORGANIZATION_ID=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_STARTER=
POLAR_PRODUCT_BASIC=
POLAR_PRODUCT_POPULAR=
POLAR_PRODUCT_BEST=
POLAR_PRODUCT_SUBSCRIPTION_PRO=
POLAR_PRODUCT_SUBSCRIPTION_PREMIUM=
POLAR_SDK_TIMEOUT_MS=30000

# 메일: null이면 발송하지 않는다. resend/sendgrid는 키와 사용자 발신자가 모두 필요하다.
EMAIL_PROVIDER=null
EMAIL_FROM_ADDRESS=
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_TOKEN_PEPPER=

# 로컬 검사 중 주기 작업 차단. 실제 운영 시 각 작업의 역할을 검토한 뒤 0으로 변경한다.
RECONCILIATION_DISABLED=1
WEBHOOK_RETRY_DISABLED=1
PAYMENT_CLEANUP_DISABLED=1
MONTHLY_POOL_RESET_DISABLED=1
USER_HARD_DELETE_DISABLED=1
AUDIT_MASK_DISABLED=1

# 가상 데이터/관리자 초기화에만 사용. 비밀번호를 로그나 명령줄에 적지 않는다.
SEED_PASSWORD=
SEED_ADMIN_SLUG=local-admin
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_NAME=Local Administrator
SEED_ADMIN_PASSWORD=
SEED_API_URL=http://localhost:3000/api
