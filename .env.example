# 필수
DATABASE_URL=postgresql://grimoireadmin:PASSWORD@grimoire-db-dev.postgres.database.azure.com:5432/grimoire?sslmode=require
ANTHROPIC_API_KEY=sk-ant-...
JWT_SECRET=your-jwt-secret-here

# 선택 (없으면 해당 기능 비활성화)
GOOGLE_CLIENT_ID=
OPENAI_API_KEY=

# Polar 결제 (MoR, 기본 production — KYC 전에는 test mode 표시)
# POLAR_SERVER: 'production' | 'sandbox' (sandbox는 별도 sandbox.polar.sh 계정 필요)
POLAR_ACCESS_TOKEN=polar_oat_...
POLAR_SERVER=production
POLAR_ORGANIZATION_ID=
POLAR_WEBHOOK_SECRET=polar_whs_...
POLAR_PRODUCT_BASIC=
POLAR_PRODUCT_POPULAR=
POLAR_PRODUCT_BEST=

# Azure Blob Storage (커버 이미지 — 없으면 업로드 비활성화)
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=

# 서버 설정
PORT=3000
CORS_ORIGIN=http://localhost:3001
NODE_ENV=development
